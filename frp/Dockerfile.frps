FROM alpine:3

ARG TARGETARCH
ARG VERSION

RUN set -ex \
    && apk add --no-cache tzdata ca-certificates curl \
    && ARCH=$(case "$TARGETARCH" in \
         amd64) echo "amd64" ;; \
         arm64) echo "arm64" ;; \
         *)     echo "unsupported" && exit 1 ;; \
       esac) \
    && curl -fsSL "https://github.com/fatedier/frp/releases/download/v${VERSION}/frp_${VERSION}_linux_${ARCH}.tar.gz" \
       | tar -xz --strip-components=1 -C /usr/bin "frp_${VERSION}_linux_${ARCH}/frps" \
    && chmod +x /usr/bin/frps \
    && apk del curl

ENTRYPOINT ["/usr/bin/frps"]
