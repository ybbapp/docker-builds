# Tailscale auth key. Use an ephemeral/reusable key appropriate for your tailnet.
TS_AUTHKEY=tskey-auth-CHANGEME

# Node name shown in the Tailscale admin console.
TS_HOSTNAME=tailscale-exitnode

# Network kernel: singbox (default) or mihomo.
NETWORK_KERNEL=singbox

# Optional exporter settings. If omitted, the exporter logs a warning and stays disabled.
# singbox kernel: expose metrics from sing-box Clash API via the built-in clash exporter.
CLASH_EXPORTER_HOST=localhost:9090
CLASH_EXPORTER_TOKEN=
CLASH_EXPORTER_LISTEN=0.0.0.0:2112

# mihomo kernel: expose nginx stub_status metrics via the built-in nginx exporter.
# NGINX_EXPORTER_SCRAPE_URI=http://localhost:81/stub_status
# NGINX_EXPORTER_LISTEN=0.0.0.0:9113

# Routes advertised by this node. Keep empty to avoid advertising subnet routes.
# Example:
# TS_ROUTES=192.168.0.0/24,10.0.0.0/8,0.0.0.0/0,::/0
TS_ROUTES=0.0.0.0/0,::/0

# Optional custom control server, for example Headscale.
# Leave empty to use the official Tailscale control plane.
# Arguments passed to `tailscale up` by the official containerboot binary.
TS_EXTRA_ARGS=--advertise-exit-node --accept-routes

# Example for Headscale or another custom control server:
# TS_EXTRA_ARGS=--advertise-exit-node --accept-routes --login-server=https://headscale.example.com

# containerboot adds --tun=userspace-networking automatically when TS_USERSPACE=true.
TS_TAILSCALED_EXTRA_ARGS=
